            VALUE "CompanyName", "Yukino Counter\0"
            VALUE "FileDescription", "Yukino Counter Portable\0"
            VALUE "FileVersion", "1.1.1\0"
            VALUE "InternalName", "YukinoCounterPortable\0"
            VALUE "OriginalFilename", "YukinoCounter-Portable-1.1.1.exe\0"
            VALUE "ProductName", "Yukino Counter\0"
            VALUE "ProductVersion", "1.1.1\0"
        END
    END
    BLOCK "VarFileInfo"
